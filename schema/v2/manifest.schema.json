{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakumatsu-people-navigator.local/schema/v2/manifest.schema.json",
  "title": "data/manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "contentVersion", "updated"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "title": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" }
  }
}
