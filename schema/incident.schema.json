{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakumatsu-people-navigator.local/schema/incident.schema.json",
  "title": "時点の中の個別事件",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sceneId", "title", "date", "summary", "stakes", "turningPoint", "participants", "relations", "placeIds", "evidence"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "sceneId": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+$" },
    "title": { "$ref": "#/$defs/text" },
    "date": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "stakes": { "$ref": "#/$defs/text" },
    "turningPoint": { "$ref": "#/$defs/text" },
    "participants": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["personId", "displayName", "role", "involvement", "summary", "evidence"],
        "properties": {
          "personId": { "$ref": "#/$defs/id" },
          "displayName": { "$ref": "#/$defs/text" },
          "role": { "$ref": "#/$defs/text" },
          "involvement": { "enum": ["onsite", "decision", "context"] },
          "summary": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "aPersonId", "bPersonId", "label", "description", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "aPersonId": { "$ref": "#/$defs/id" },
          "bPersonId": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "placeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceIds", "reviewStatus"],
      "properties": {
        "sourceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "reviewStatus": { "enum": ["verified", "needs_review", "disputed"] },
        "note": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "if": { "properties": { "reviewStatus": { "const": "verified" } }, "required": ["reviewStatus"] }, "then": { "properties": { "sourceIds": { "minItems": 1 } } } }]
    }
  }
}
